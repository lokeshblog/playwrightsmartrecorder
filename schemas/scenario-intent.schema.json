{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playwright-codegen-smart.dev/schemas/scenario-intent.schema.json",
  "title": "Playwright Scenario Intent",
  "type": "object",
  "required": [
    "version",
    "name",
    "startUrl",
    "endUrl",
    "productHints",
    "testCases",
    "unresolvedStepIndexes"
  ],
  "properties": {
    "version": { "const": "1.0" },
    "name": { "type": "string" },
    "startUrl": { "type": "string" },
    "endUrl": { "type": "string" },
    "productHints": {
      "type": "object",
      "required": ["navModules", "pageHeadings", "features"],
      "properties": {
        "navModules": { "type": "array", "items": { "type": "string" } },
        "pageHeadings": { "type": "array", "items": { "type": "string" } },
        "features": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "testCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "steps"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "jiraId": { "type": "string" },
          "zephyrId": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "index",
                "startUrl",
                "urlAfter",
                "intent",
                "action",
                "skipInTest",
                "confidence"
              ],
              "properties": {
                "index": { "type": "integer", "minimum": 1 },
                "startUrl": { "type": "string" },
                "urlAfter": { "type": "string" },
                "intent": { "type": "string" },
                "action": {
                  "enum": [
                    "click",
                    "doubleClick",
                    "hover",
                    "fill",
                    "selectOption",
                    "setInputFiles",
                    "check",
                    "uncheck",
                    "press",
                    "navigate",
                    "assert"
                  ]
                },
                "value": { "type": "string" },
                "locatorHint": {
                  "type": "object",
                  "properties": {
                    "testId": { "type": "string" },
                    "nameHint": { "type": "string" },
                    "role": { "type": "string" },
                    "name": { "type": "string" },
                    "tagName": { "type": "string" },
                    "scope": { "type": "string" },
                    "expression": { "type": "string" }
                  },
                  "additionalProperties": false
                },
                "disabledState": { "$ref": "#/$defs/disabledState" },
                "productHints": { "type": "object" },
                "skipInTest": { "type": "boolean" },
                "valueKind": {
                  "type": "object",
                  "required": ["unique", "createsResource"],
                  "properties": {
                    "kind": { "enum": ["secret", "unique", "literal"] },
                    "unique": { "type": "boolean" },
                    "createsResource": { "type": "boolean" }
                  },
                  "additionalProperties": false
                },
                "expect": {
                  "type": "object",
                  "required": ["kind", "matcher"],
                  "properties": {
                    "kind": {
                      "enum": ["heading", "toast", "row-visible", "assertion"]
                    },
                    "matcher": { "type": "string" },
                    "value": {
                      "type": ["string", "number", "boolean", "array"],
                      "items": { "type": "string" }
                    },
                    "name": { "type": "string" },
                    "signals": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "disabled-attribute",
                          "aria-disabled",
                          "native-disabled",
                          "bp3-disabled"
                        ]
                      }
                    },
                    "group": {
                      "type": "object",
                      "properties": {
                        "notAuthorized": { "type": "string" },
                        "missingPermission": { "type": "string" },
                        "permissionInScope": { "type": "string" }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "confidence": {
                  "enum": ["high", "medium", "low", "unresolved"]
                },
                "context": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "unresolvedStepIndexes": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    }
  },
  "$defs": {
    "disabledState": {
      "type": "object",
      "required": [
        "hasDisabledAttribute",
        "ariaDisabled",
        "nativeDisabled",
        "blueprintDisabledClass",
        "tabIndex",
        "tagName",
        "role"
      ],
      "properties": {
        "hasDisabledAttribute": { "type": "boolean" },
        "ariaDisabled": { "enum": ["true", null] },
        "nativeDisabled": { "type": "boolean" },
        "blueprintDisabledClass": { "type": "boolean" },
        "tabIndex": { "type": ["integer", "null"] },
        "tagName": { "type": "string" },
        "role": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

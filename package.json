{
  "name": "playwright-codegen-smart",
  "version": "1.9.0",
  "description": "Record, replay, repair, and convert Playwright scenarios with deterministic locator context.",
  "type": "module",
  "bin": {
    "playwright-codegen-smart": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run build && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "playwright": ">=1.45.0"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4",
    "playwright": "^1.55.0"
  },
  "keywords": [
    "playwright",
    "codegen",
    "replay",
    "testing",
    "locator"
  ],
  "license": "MIT"
}
